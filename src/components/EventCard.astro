---
import StatusBadge from './StatusBadge.astro';
import { eventCover, typeLabels, formatDate } from '~/lib/journal';
interface Props {
  id: string; title: string; summary: string; type: string; dateStart: Date; dateEnd?: Date;
  status: 'draft' | 'submitted' | 'reviewing' | 'published' | 'archived' | 'withdrawn';
  tags?: string[]; sourceCount: number; timelineCount: number;
}
const { id, title, summary, type, dateStart, dateEnd, status, sourceCount, timelineCount } = Astro.props;
const cover = eventCover(id);
---
<a href={`/events/${id}`} class:list={["journal-card card-link", { "journal-card--no-cover": !cover }]}>
  {cover && <div class="journal-card-frame">
    <div class="journal-card-image" data-image-kind={cover.kind}>
      <img src={cover.src} alt={cover.alt} width={cover.width} height={cover.height} loading="lazy" />
      {cover.kind === 'photo' && <span class="image-cta" aria-hidden="true"><img src="/icons/arrow.svg" alt="" /></span>}
    </div>
    <span class="image-note">{cover.label}</span>
  </div>}
  <div class="journal-card-body">
    <div class="journal-card-category"><span>{typeLabels[type] ?? type}</span><StatusBadge status={status} size="sm" /></div>
    <p class="card-date">{formatDate(dateStart)}{dateEnd && ` — ${formatDate(dateEnd)}`}</p>
    <h3 class="card-title">{title}</h3>
    <p class="card-summary">{summary}</p>
    <div class="card-evidence"><span>{timelineCount} 个时间节点</span><span>{sourceCount} 条信源<img src="/icons/arrow.svg" alt="" /></span></div>
  </div>
</a>

<style>
  /* Event-card density lives here; parent grids only decide column count and gap. */
  .journal-card { display: flex; flex-direction: column; height: 100%; min-width: 0; overflow: hidden; padding: 0; border: 1px solid var(--line); border-radius: 9px; background: var(--surface); color: var(--text); text-decoration: none; transition: border-color .2s ease, transform .2s ease; }
  .journal-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .journal-card-frame { flex-shrink: 0; padding: 7px 7px 0; }
  .journal-card-image { position: relative; overflow: hidden; aspect-ratio: 2.4 / 1; border-radius: 5px; background: var(--surface-raised); }
  .journal-card-image > img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .journal-card-image[data-image-kind="document"] > img { object-fit: contain; }
  .journal-card:hover .journal-card-image[data-image-kind="photo"] > img { transform: scale(1.025); }
  .image-note { display: block; margin: 5px 2px 0; color: var(--muted); font-size: 9px; line-height: 1.4; overflow-wrap: anywhere; }
  .image-cta { position: absolute; right: 7px; bottom: 7px; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--accent); opacity: 0; transition: opacity .2s ease; }
  .image-cta img { width: 13px; height: 13px; filter: brightness(0); }
  .journal-card:hover .image-cta,.journal-card:focus-visible .image-cta { opacity: 1; }
  .journal-card-body { display: flex; flex: 1; flex-direction: column; min-width: 0; padding: 11px 14px 13px; }
  .journal-card-category { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 4px 8px; margin-bottom: 5px; color: var(--muted); font-size: 10px; line-height: 1.4; }
  .journal-card-category :global(.badge) { padding: 2px 6px; font-size: 9px; line-height: 1.4; }
  .card-date { margin: 0 0 7px; color: var(--muted); font-size: 10px; line-height: 1.5; font-variant-numeric: tabular-nums; }
  .card-title { margin: 0 0 8px; color: var(--text); font-size: 18px; font-weight: 650; line-height: 1.45; letter-spacing: -.025em; overflow-wrap: anywhere; }
  .card-summary { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; margin: 0 0 11px; color: var(--muted); font-size: 12px; line-height: 1.7; overflow-wrap: anywhere; }
  .card-evidence { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 5px 8px; margin-top: auto; padding-top: 10px; border-top: 1px solid var(--line); color: var(--muted); font-size: 10px; line-height: 1.5; }
  .card-evidence > span:last-child { display: inline-flex; align-items: center; gap: 7px; color: var(--text); }
  .card-evidence img { width: 12px; height: 12px; filter: grayscale(1) brightness(0) invert(1); }
  @media (max-width: 599px) {
    .journal-card { display: grid; grid-template-columns: 84px minmax(0, 1fr); gap: 12px; padding: 12px; height: auto; }
    .journal-card-frame { align-self: start; padding: 0; }
    .journal-card-image { height: 104px; aspect-ratio: auto; }
    .journal-card-image > img { object-position: center; }
    .image-note { margin: 5px 0 0; font-size: 8px; }
    .image-cta { display: none; }
    .journal-card-body { padding: 0; }
    .journal-card-category { gap: 3px 6px; margin-bottom: 4px; font-size: 9px; }
    .journal-card-category :global(.badge) { padding: 1px 4px; font-size: 8px; }
    .card-date { margin-bottom: 5px; font-size: 9px; }
    .card-title { margin-bottom: 6px; font-size: 17px; line-height: 1.45; }
    .card-summary { margin-bottom: 8px; font-size: 11px; line-height: 1.65; }
    .card-evidence { gap: 4px 7px; padding-top: 7px; font-size: 9px; }
  }
  @media (max-width: 359px) {
    .journal-card { grid-template-columns: 68px minmax(0, 1fr); gap: 10px; padding: 10px; }
    .journal-card-image { height: 88px; }
  }
  .journal-card--no-cover { grid-template-columns: minmax(0, 1fr); }
  @media (prefers-reduced-motion: reduce) { .journal-card, .journal-card-image > img { transition: none; } .journal-card:hover, .journal-card:hover .journal-card-image > img { transform: none; } }
</style>
