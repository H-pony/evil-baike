---
/**
 * FilterBar - 列表页筛选器（URL 参数 + 客户端 JS 增强）
 *
 * 工作机制：
 * - 链接 href 仍构造 URL 参数（无 JS 也可点击，浏览器跳转到 ?type=X 页面）
 * - 但页面本身 SSR 渲染全部条目，由各列表页 [data-filter-bar] 标识的 JS 在客户端
 *   按 URL 参数 hide/show。URL 改动由 history.pushState 不刷新页面。
 *
 * 因此 FilterBar 的链接 click 需要 preventDefault + pushState。
 */

interface FilterOption {
  value: string;
  label: string;
  count?: number;
}

interface FilterGroup {
  name: string;
  label: string;
  options: FilterOption[];
}

interface Props {
  filters: FilterGroup[];
  current: Record<string, string | undefined>;  // 服务端初始状态（保留兼容）
  basePath: string;
  'data-filter-bar'?: string;
}

const { filters, current, basePath, ...attrs } = Astro.props;

function buildUrl(name: string, value: string | null): string {
  const params = new URLSearchParams();
  for (const [key, entry] of Object.entries(current)) if (entry) params.set(key, entry);
  if (value === null) params.delete(name);
  else params.set(name, value);
  const qs = params.toString();
  return qs ? `${basePath}?${qs}` : basePath;
}

function isActive(name: string, value: string | undefined): boolean {
  return current[name] === value;
}

function activeFilterCount(): number {
  return Object.values(current).filter(Boolean).length;
}
---

<div class="archive-box mb-6 p-4" {...attrs}>
  <div class="flex items-baseline gap-2 mb-3">
    <span class="meta-stamp">筛选</span>
      <a
        href={basePath}
        data-filter-clear
        hidden={activeFilterCount() === 0}
        class="meta-stamp text-archive-seal hover:underline no-underline"
      >
        清除筛选
      </a>
  </div>

  <div class="space-y-3">
    {filters.map((group) => (
      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
        <span class="meta-stamp text-ink-faded shrink-0 w-16">{group.label}:</span>
        <a
          href={buildUrl(group.name, null)}
          data-filter-all={group.name}
          class="text-xs font-mono uppercase tracking-wider px-2 py-0.5 border border-ink-900/30 text-ink-muted hover:border-archive-seal hover:text-archive-seal transition-colors no-underline"
        >
          全部
        </a>
        {group.options.map((opt) => (
          <a
            href={buildUrl(group.name, isActive(group.name, opt.value) ? null : opt.value)}
            data-filter-chip
            data-filter-name={group.name}
            data-filter-value={opt.value}
            class="text-xs font-mono uppercase tracking-wider px-2 py-0.5 border border-ink-900/30 text-ink-muted hover:border-archive-seal hover:text-archive-seal transition-colors no-underline inline-flex items-center gap-1"
          >
            {opt.label}
            {opt.count !== undefined && (
              <span class="text-[10px] opacity-60">[{opt.count}]</span>
            )}
          </a>
        ))}
      </div>
    ))}
  </div>
</div>

<noscript><p class="text-sm text-ink-muted mb-4">筛选需要启用 JavaScript；当前展示全部档案。</p></noscript>
<script>
  document.querySelectorAll<HTMLElement>('[data-filter-bar]').forEach((bar) => {
    const links = Array.from(bar.querySelectorAll<HTMLAnchorElement>('[data-filter-chip], [data-filter-all], [data-filter-clear]'));
    const names = [...new Set(links.map(link => link.dataset.filterName || link.dataset.filterAll).filter(Boolean))] as string[];
    const targetUrl = (link: HTMLAnchorElement) => {
      const params = new URLSearchParams(window.location.search);
      const name = link.dataset.filterName || link.dataset.filterAll;
      if (link.hasAttribute('data-filter-clear')) names.forEach(key => params.delete(key));
      else if (name) {
        const value = link.dataset.filterValue;
        if (!value || params.get(name) === value) params.delete(name);
        else params.set(name, value);
      }
      const query = params.toString();
      return window.location.pathname + (query ? `?${query}` : '');
    };
    const syncLinks = () => {
      const params = new URLSearchParams(window.location.search);
      links.forEach(link => {
        link.href = targetUrl(link);
        if (link.hasAttribute('data-filter-clear')) {
          link.hidden = !names.some(name => params.has(name));
          return;
        }
        const name = link.dataset.filterName || link.dataset.filterAll || '';
        const active = (params.get(name) || '') === (link.dataset.filterValue || '');
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };
    links.forEach(link => link.addEventListener('click', event => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      const url = targetUrl(link);
      if (url !== window.location.pathname + window.location.search) window.history.pushState({}, '', url);
      window.dispatchEvent(new CustomEvent('evil-baike:filter-changed'));
    }));
    window.addEventListener('popstate', syncLinks);
    window.addEventListener('evil-baike:filter-changed', syncLinks);
    syncLinks();
  });
</script>
