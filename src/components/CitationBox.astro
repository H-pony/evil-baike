---
/**
 * CitationBox - 学术引用盒（APA / Chicago / BibTeX）
 *
 * 默认从 entry frontmatter 自动推断：
 *   - 标题 / 作者 / 审校 / 创建日期
 *   - URL = Astro.site + canonical path
 *   - 站点名 = '恶人百科'
 *   - 访问日期 = 当前日期（"Web 资源"必须）
 */

interface Props {
  type: 'event' | 'person' | 'organization';
  id: string;            // slug
  title: string;
  authors?: string[];
  reviewers?: string[];
  createdAt?: Date;
  updatedAt?: Date;
  url?: string;          // 不传时使用当前 canonical URL
}

const { type, id, title, authors = [], reviewers = [], createdAt, updatedAt } = Astro.props;

const siteName = '恶人百科';
const slugPath = type === 'event' ? 'events' : type === 'person' ? 'people' : 'organizations';
const canonicalUrl = Astro.props.url ?? `${Astro.site ?? 'https://schemer.online'}/${slugPath}/${id}`;

const accessDate = new Date().toISOString().slice(0, 10);
const pubYear = (createdAt ?? new Date()).getUTCFullYear();
const pubDate = (createdAt ?? new Date()).toISOString().slice(0, 10);
const updDate = updatedAt ? updatedAt.toISOString().slice(0, 10) : pubDate;

const authorList = authors.length > 0 ? authors.join(', ') : 'Anonymous';
const reviewerNote = reviewers.length > 0 ? ` (Reviewed by ${reviewers.join(', ')})` : '';

// APA 7
const apa = `${authorList}${reviewerNote}. (${pubYear}). ${title}. ${siteName}. Retrieved ${accessDate}, from ${canonicalUrl}`;

// Chicago (Author-Date)
const chicago = `${authorList}${reviewerNote}. ${pubYear}. "${title}." ${siteName}. Last modified ${updDate}. ${canonicalUrl}.`;

// MLA 9
const mla = `${authorList}${reviewerNote}. "${title}." ${siteName}, ${updDate}, ${canonicalUrl}. Accessed ${accessDate}.`;

// BibTeX
const bibKey = `evilbaike-${type}-${id}-${pubYear}`.toLowerCase();
const bibtex = `@misc{${bibKey},
  title   = {${title}},
  author  = {${authorList}},
  year    = {${pubYear}},
  month   = {${(createdAt ?? new Date()).toISOString().slice(5, 7)}},
  url     = {${canonicalUrl}},
  urldate = {${accessDate}},
  note    = {${siteName}; Reviewed by ${reviewers.join(', ') || 'N/A'}}
}`;
---

<details class="archive-box mt-6 group" data-cite-box>
  <summary class="cursor-pointer flex items-center justify-between">
    <span class="meta-stamp">引用此条目</span>
    <span class="meta-stamp text-ink-faded group-open:hidden">[展开]</span>
    <span class="meta-stamp text-ink-faded hidden group-open:inline">[收起]</span>
  </summary>

  <div class="mt-4 space-y-4 text-sm">
    <div>
      <div class="flex items-center justify-between mb-1">
        <span class="meta-stamp">APA 7</span>
        <button type="button" data-cite-copy={apa} class="meta-stamp text-archive-seal hover:underline">复制</button>
      </div>
      <blockquote class="blockquote">{apa}</blockquote>
    </div>

    <div>
      <div class="flex items-center justify-between mb-1">
        <span class="meta-stamp">Chicago (Author-Date)</span>
        <button type="button" data-cite-copy={chicago} class="meta-stamp text-archive-seal hover:underline">复制</button>
      </div>
      <blockquote class="blockquote">{chicago}</blockquote>
    </div>

    <div>
      <div class="flex items-center justify-between mb-1">
        <span class="meta-stamp">MLA 9</span>
        <button type="button" data-cite-copy={mla} class="meta-stamp text-archive-seal hover:underline">复制</button>
      </div>
      <blockquote class="blockquote">{mla}</blockquote>
    </div>

    <div>
      <div class="flex items-center justify-between mb-1">
        <span class="meta-stamp">BibTeX</span>
        <button type="button" data-cite-copy={bibtex} class="meta-stamp text-archive-seal hover:underline">复制</button>
      </div>
      <pre class="archive-box overflow-x-auto text-xs font-mono whitespace-pre">{bibtex}</pre>
    </div>

    <p class="text-xs text-ink-muted">
      提示：引用网络资源时必须包含访问日期（urldate / Retrieved / Accessed）。
      本档案馆所有事实均标注信源，建议同时引用 <a href="#sources">信源章节</a> 中对应的原始报道。
    </p>
  </div>
</details>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-cite-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.citeCopy ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      const orig = btn.textContent;
      btn.textContent = '✓ 已复制';
      setTimeout(() => { btn.textContent = orig; }, 2000);
    });
  });
</script>
