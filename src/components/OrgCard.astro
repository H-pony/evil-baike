---
/**
 * OrgCard - 机构卡片（列表页用）
 */

import StatusBadge from './StatusBadge.astro';

interface Props {
  id: string;
  name: string;
  summary: string;
  type: string;
  status: 'draft' | 'submitted' | 'reviewing' | 'published' | 'archived' | 'withdrawn';
  aliases?: string[];
  eventCount: number;
}

const { id, name, summary, type, status, aliases = [], eventCount } = Astro.props;
---

<a href={`/organizations/${id}`} class="entity-card card-link block archive-box hover:border-archive-seal transition-colors">
  <div class="flex items-start justify-between gap-3 mb-2">
    <span class="entity-kind">{type}</span>
    <StatusBadge status={status} size="sm" />
  </div>

  <h3 class="card-title font-display font-semibold text-xl mb-2 leading-tight">
    {name}
  </h3>

  {aliases.length > 0 && (
    <p class="entity-aliases">又称：{aliases.join(' · ')}</p>
  )}

  <p class="entity-summary">{summary}</p>

  <div class="entity-count">
    涉及事件 {eventCount}
  </div>
</a>
<style>
  .entity-card { display: flex; flex-direction: column; height: 100%; min-width: 0; padding: 26px; border: 1px solid var(--line); border-radius: 9px; background: var(--surface); color: var(--text); text-decoration: none; transition: border-color .2s ease; }
  .entity-card:hover { border-color: var(--accent); }
  .entity-kind { color: var(--muted); font-size: 10px; letter-spacing: .08em; }
  .card-title { margin: 20px 0 12px; color: var(--text); font-size: clamp(25px, 2.1vw, 29px); line-height: 1.4; letter-spacing: -.05em; font-weight: 700; }
  .entity-aliases { margin: 0 0 14px; color: var(--muted); font-size: 11px; line-height: 1.8; }
  .entity-summary { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; margin: 0 0 24px; color: var(--muted); font-size: 13px; line-height: 1.9; }
  .entity-count { margin-top: auto; padding-top: 15px; border-top: 1px solid var(--line); color: var(--text); font-size: 11px; text-align: right; }
  @media (max-width: 600px) { .entity-card { padding: 22px; } }
</style>
