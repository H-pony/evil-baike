---
const year = new Date().getFullYear();
---
<footer class="journal-footer">
  <div class="footer-follow">
    <p class="eyebrow">KEEP THE RECORD OPEN.</p>
    <div class="footer-action-row">
      <a href="/submit" class="footer-cta"><h2>让记录<br />持续发生。</h2><span class="cta-arrow" aria-hidden="true"><img src="/icons/arrow.svg" alt="" /></span><span class="cta-label">投稿 / 更正</span></a>
      <div class="footer-qq">
        <button id="qq-group-trigger" class="footer-qq-trigger" type="button" aria-haspopup="dialog" aria-controls="qq-group-panel" aria-expanded="false" aria-label="放大 QQ 交流群二维码，群号 1121513455">
          <span class="qq-code-frame"><img src="/images/qq-group-1121513455.png" width="1284" height="2289" alt="QQ 群二维码，群号 1121513455" loading="lazy" decoding="async" /></span>
          <span class="footer-qq-copy"><strong>QQ 交流群</strong><span>群号 1121513455</span><small>扫码加入 · 点击放大</small></span>
        </button>
      </div>
    </div>
    <div class="footer-follow-bottom"><p>阅读新档案，补充信源。<br />让事件的来龙去脉被记住。</p><a href="/rss.xml" class="footer-rss">订阅 RSS <img class="footer-direction" src="/icons/arrow.svg" alt="" /></a></div>
  </div>
  <div class="footer-bottom"><a href="/" class="footer-brand">恶人百科<span>THE PUBLIC ARCHIVE</span></a><nav aria-label="页脚导航"><a href="/about">关于项目</a><a href="/methodology">收录方法论</a><a href="/disclaimer">免责声明</a><a href="/methodology#takedown">下架与申诉</a><a href="/favorites">我的收藏</a></nav><button id="back-to-top" class="back-to-top no-print" type="button" aria-label="回到顶部"><img class="footer-up" src="/icons/arrow.svg" alt="" /></button></div>
  <div class="footer-legal"><p>本站汇总公开报道与信源，不对当事人作法律或道德定性。</p><p>© {year} 恶人百科 · CC BY-NC-SA 4.0</p></div>
</footer>
<dialog id="qq-group-panel" class="qq-group-dialog" aria-labelledby="qq-group-title" aria-describedby="qq-group-description">
  <div class="qq-dialog-top"><h2 id="qq-group-title">QQ 交流群</h2><button id="qq-group-close" class="qq-dialog-close" type="button" aria-label="关闭二维码"><img src="/icons/close.svg" alt="" /></button></div>
  <p id="qq-group-description">群号 1121513455 · 使用 QQ 扫码加入</p>
  <div class="qq-code-frame qq-code-large"><img src="/images/qq-group-1121513455.png" width="1284" height="2289" alt="QQ 群二维码，群号 1121513455" decoding="async" /></div>
  <a class="qq-original-link" href="/images/qq-group-1121513455.png" target="_blank" rel="noopener">查看原图 <span aria-hidden="true">↗</span></a>
</dialog>
<style>
  .journal-footer { margin: 0; padding: 0 clamp(24px,5vw,80px); border-top: 1px solid var(--line,#37383b); background: #111214; color: var(--text,#f4f2e9); }
  .footer-follow { display: block; padding: clamp(60px,8vw,120px) 0 48px; border-bottom: 1px solid var(--line,#37383b); }
  .eyebrow { font: 500 11px/1.5 Geist,sans-serif; letter-spacing: .16em; color: var(--muted,#aaa9a4); }
  .footer-action-row { display: grid; grid-template-columns: minmax(0,1fr) 190px; align-items: center; gap: clamp(32px,5vw,80px); margin-top: 40px; }
  .footer-cta { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 24px 40px; min-width: 0; color: inherit; text-decoration: none; }
  .footer-cta h2 { margin: 0; font-size: clamp(52px,7.8vw,116px); line-height: 1.13; letter-spacing: -.06em; font-weight: 600; }
  .cta-arrow { display: grid; place-items: center; width: clamp(72px,10vw,148px); height: clamp(72px,10vw,148px); border: 1px solid var(--line,#37383b); border-radius: 50%; color: var(--accent,#d7ff36); font-size: clamp(42px,6vw,80px); font-weight: 300; transition: color .25s,background .25s,border-color .25s; }
  .cta-arrow img { width:45%; height:45%; transform:rotate(-45deg); filter:brightness(0) saturate(100%) invert(88%) sepia(84%) saturate(565%) hue-rotate(17deg); }
  .footer-cta:hover .cta-arrow img { filter:brightness(0); }
  .footer-direction,.footer-up { width:20px; height:20px; transform:rotate(-45deg); filter:brightness(0) invert(1); }
  .footer-up { transform:rotate(-90deg); }
  .cta-label { grid-column: 2; justify-self: center; font-size: 12px; letter-spacing: .08em; }
  .footer-cta:hover .cta-arrow { background: var(--accent,#d7ff36); border-color: var(--accent,#d7ff36); color: #111214; }
  .footer-qq-trigger { display: block; width: 100%; padding: 12px; border: 1px solid var(--line,#37383b); border-radius: 8px; color: inherit; background: var(--surface,#1c1d21); text-align: left; transition: border-color .2s; }
  .footer-qq-trigger:hover { border-color: var(--accent,#d7ff36); }
  .qq-code-frame { position: relative; display: block; width: 100%; aspect-ratio: 1; overflow: hidden; border-radius: 4px; background: #fff; }
  /* Preserve the uploaded PNG; this viewport includes the QR's white quiet margin. */
  .qq-code-frame img { position: absolute; width: 139.565218%; max-width: none; height: auto; left: -19.782609%; top: -78.804348%; }
  .footer-qq-copy { display: block; margin-top: 12px; }
  .footer-qq-copy strong { display: block; font-size: 14px; font-weight: 550; line-height: 1.5; }
  .footer-qq-copy > span { display: block; margin-top: 4px; color: var(--muted,#aaa9a4); font-size: 11px; line-height: 1.6; }
  .footer-qq-copy small { display: block; margin-top: 7px; color: var(--muted,#aaa9a4); font-size: 10px; line-height: 1.6; }
  .qq-group-dialog { width: min(400px,calc(100% - 32px)); max-height: calc(100dvh - 32px); margin: auto; padding: 28px; overflow-y: auto; overscroll-behavior: contain; border: 1px solid var(--line,#37383b); border-radius: 10px; background: var(--surface,#1c1d21); color: var(--text,#f4f2e9); }
  .qq-group-dialog::backdrop { background: rgb(0 0 0 / .8); backdrop-filter: blur(12px); }
  .qq-dialog-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .qq-dialog-top h2 { margin: 0; font-size: 22px; line-height: 1.4; font-weight: 600; }
  .qq-dialog-close { display: grid; place-items: center; flex-shrink: 0; width: 44px; height: 44px; padding: 0; border: 1px solid var(--line,#37383b); border-radius: 50%; background: transparent; }
  .qq-dialog-close img { width: 15px; height: 15px; filter: brightness(0) invert(1); }
  .qq-dialog-close:hover { border-color: var(--accent,#d7ff36); }
  #qq-group-description { margin: 8px 0 24px; color: var(--muted,#aaa9a4); font-size: 12px; line-height: 1.7; }
  .qq-code-large { max-width: 344px; margin-inline: auto; }
  .qq-original-link { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; margin-top: 14px; color: var(--muted,#aaa9a4); font-size: 12px; text-underline-offset: 4px; }
  .qq-original-link:hover { color: var(--accent,#d7ff36); }
  .footer-follow-bottom { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-top: 40px; }
  .footer-follow-bottom p { font-size: 14px; line-height: 1.9; color: var(--muted,#aaa9a4); }
  .footer-rss { display: inline-flex; align-items: center; justify-content: space-between; gap: 56px; min-height: 44px; border-bottom: 1px solid var(--line,#37383b); font-size: 13px; text-decoration: none; }
  .footer-rss:hover { color: var(--accent,#d7ff36); border-color: currentColor; }
  .footer-bottom { display: flex; align-items: center; gap: 36px; padding: 36px 0 22px; }
  .footer-brand { flex-shrink: 0; color: inherit; font-size: 24px; font-weight: 700; line-height: 1.3; letter-spacing: -.05em; text-decoration: none; }
  .footer-brand span { display: block; margin-top: 8px; color: var(--muted,#aaa9a4); font-size: 8px; font-weight: 500; letter-spacing: .15em; }
  .footer-bottom nav { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 2px 26px; margin-left: auto; }
  .footer-bottom nav a { display: inline-flex; align-items: center; min-height: 44px; color: var(--muted,#aaa9a4); font-size: 12px; text-decoration: none; }
  .footer-bottom nav a:hover { color: var(--text,#f4f2e9); text-decoration: underline; }
  .back-to-top { display: grid; place-items: center; flex-shrink: 0; width: 48px; height: 48px; padding: 0; border: 1px solid var(--line,#37383b); border-radius: 50%; color: var(--text,#f4f2e9); background: transparent; font-size: 24px; }
  .back-to-top:hover { color: var(--accent,#d7ff36); border-color: currentColor; }
  .footer-legal { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px 24px; padding: 0 0 28px; color: var(--muted,#aaa9a4); font-size: 10px; }
  a:focus-visible,button:focus-visible { outline: 2px solid var(--accent,#d7ff36); outline-offset: 6px; }
  @media (max-width: 800px) {
    .footer-action-row { grid-template-columns: minmax(0,1fr) 170px; gap: 28px; }
    .footer-cta { gap: 20px; }
    .footer-cta h2 { font-size: clamp(44px,7.4vw,60px); }
    .footer-bottom { flex-wrap: wrap; gap: 24px; }
    .footer-brand { flex: 1; }
    .footer-bottom nav { order: 3; justify-content: flex-start; width: 100%; margin: 0; gap: 4px 24px; }
  }
  @media (max-width: 600px) {
    .journal-footer { padding-inline: 22px; }
    .footer-follow { padding-block: 56px 34px; }
    .footer-action-row { grid-template-columns: minmax(0,1fr); margin-top: 30px; gap: 28px; }
    .footer-cta { gap: 14px; }
    .footer-cta h2 { grid-column: 1 / -1; font-size: clamp(44px,9.2vw,60px); }
    .cta-arrow { grid-column: 2; grid-row: 2; width: 64px; height: 64px; font-size: 36px; }
    .cta-label { grid-column: 1; grid-row: 2; justify-self: start; font-size: 12px; }
    .footer-qq-trigger { display: flex; align-items: center; gap: 16px; padding: 14px; }
    .footer-qq-trigger .qq-code-frame { width: 104px; flex-shrink: 0; }
    .footer-qq-copy { margin-top: 0; }
    .footer-qq-copy strong { font-size: 14px; }
    .footer-qq-copy > span { font-size: 12px; }
    .footer-qq-copy small { margin-top: 10px; font-size: 11px; }
    .qq-group-dialog { padding: 20px; }
    .footer-follow-bottom { margin-top: 28px; align-items: start; flex-direction: column; gap: 20px; }
    .footer-follow-bottom p { font-size: 13px; }
    .footer-rss { gap: 48px; }
    .footer-bottom { padding-block: 28px 20px; }
    .footer-bottom nav { flex-basis: 100%; gap: 0 20px; }
    .footer-legal { font-size: 10px; padding-bottom: 24px; }
  }
  @media (prefers-reduced-motion:reduce) { .cta-arrow,.footer-qq-trigger { transition: none; } }
  @media print { .journal-footer,.qq-group-dialog { display: none; } }
</style>
<script>
  document.getElementById('back-to-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: document.documentElement.classList.contains('motion-paused') ? 'instant' : 'smooth' });
  });
  const qqTrigger = document.querySelector<HTMLButtonElement>('#qq-group-trigger');
  const qqPanel = document.querySelector<HTMLDialogElement>('#qq-group-panel');
  if (qqTrigger && qqPanel) {
    qqTrigger.addEventListener('click', () => {
      if (qqPanel.open) return;
      qqPanel.showModal();
      qqTrigger.setAttribute('aria-expanded','true');
      document.body.classList.add('dialog-open');
    });
    document.getElementById('qq-group-close')?.addEventListener('click', () => qqPanel.close());
    qqPanel.addEventListener('close', () => {
      qqTrigger.setAttribute('aria-expanded','false');
      document.body.classList.toggle('dialog-open',!!document.querySelector('dialog[open]'));
      if (!document.querySelector('dialog[open]')) qqTrigger.focus();
    });
    qqPanel.addEventListener('click', event => {
      if (event.target !== qqPanel) return;
      const box = qqPanel.getBoundingClientRect();
      if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) qqPanel.close();
    });
  }
</script>
