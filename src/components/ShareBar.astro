---
/**
 * ShareBar - 分享按钮
 *
 * 优先使用 navigator.share（移动端原生），fallback 复制链接
 * 提供：原生分享 / 复制链接 / 邮件 / QR 码（静态 SVG）
 */

interface Props {
  url: string;       // 完整 URL（og:url）
  title: string;     // 标题
  summary: string;   // 摘要
}

const { url, title, summary } = Astro.props;

// 邮件链接预填
const mailSubject = encodeURIComponent(`[恶人百科] ${title}`);
const mailBody = encodeURIComponent(`${summary}\n\n${url}`);

// Twitter / X 分享
const twitterText = encodeURIComponent(`${title} — 恶人百科`);

// QR 码：使用 Google Chart QR API（免依赖、免生成）
const qrSrc = `https://chart.googleapis.com/chart?cht=qr&chs=200x200&chld=M|0&chl=${encodeURIComponent(url)}`;
---

<div class="archive-box p-4 no-print" data-share-bar data-url={url} data-title={title}>
  <div class="meta-stamp mb-3">分享</div>
  <div class="flex flex-wrap items-center gap-2">
    <button
      type="button"
      data-share-native
      class="text-xs font-mono uppercase tracking-wider px-3 py-1.5 border border-ink-900 bg-ink-900 text-archive-paper hover:border-archive-seal hover:bg-archive-seal transition-colors"
    >
      分享
    </button>

    <button
      type="button"
      data-share-copy
      data-url={url}
      class="text-xs font-mono uppercase tracking-wider px-3 py-1.5 border border-ink-900/40 hover:border-archive-seal hover:text-archive-seal transition-colors"
    >
      复制链接
    </button>

    <a
      href={`mailto:?subject=${mailSubject}&body=${mailBody}`}
      class="text-xs font-mono uppercase tracking-wider px-3 py-1.5 border border-ink-900/40 hover:border-archive-seal hover:text-archive-seal transition-colors no-underline"
    >
      邮件
    </a>

    <a
      href={`https://twitter.com/intent/tweet?text=${twitterText}&url=${encodeURIComponent(url)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="text-xs font-mono uppercase tracking-wider px-3 py-1.5 border border-ink-900/40 hover:border-archive-seal hover:text-archive-seal transition-colors no-underline"
    >
      X / Twitter
    </a>

    <button
      type="button"
      data-share-qr-toggle
      class="text-xs font-mono uppercase tracking-wider px-3 py-1.5 border border-ink-900/40 hover:border-archive-seal hover:text-archive-seal transition-colors"
    >
      QR 码
    </button>

    <span data-share-status class="text-xs font-mono text-emerald-700 dark:text-emerald-400 ml-2 hidden">✓ 已复制</span>
  </div>

  <div data-share-qr hidden class="mt-3 pt-3 border-t border-ink-900/20 flex items-start gap-3">
    <img src={qrSrc} alt="QR code" width="120" height="120" class="border border-ink-900/30 bg-white p-1" loading="lazy" />
    <p class="text-xs text-ink-muted">扫码访问本条目。QR 码由 Google Chart API 生成，请求中包含本页 URL。</p>
  </div>
</div>

<script>
  function initShareBars() {
    document.querySelectorAll<HTMLElement>('[data-share-bar]').forEach((bar) => {
      const url = bar.dataset.url ?? '';
      const title = bar.dataset.title ?? '';

      const native = bar.querySelector<HTMLButtonElement>('[data-share-native]');
      const copy = bar.querySelector<HTMLButtonElement>('[data-share-copy]');
      const qrToggle = bar.querySelector<HTMLButtonElement>('[data-share-qr-toggle]');
      const qr = bar.querySelector<HTMLElement>('[data-share-qr]');
      const status = bar.querySelector<HTMLElement>('[data-share-status]');

      if (native) {
        native.addEventListener('click', async () => {
          if (navigator.share) {
            try {
              await navigator.share({ title, url });
            } catch (err) {
              // 用户取消不报错
              if ((err as Error).name !== 'AbortError') console.warn(err);
            }
          } else {
            // fallback：复制
            await copyText(url, copy, status);
          }
        });
      }

      if (copy) {
        copy.addEventListener('click', async () => {
          await copyText(url, copy, status);
        });
      }

      if (qrToggle && qr) {
        qrToggle.addEventListener('click', () => {
          qr.hidden = !qr.hidden;
          qrToggle.textContent = qr.hidden ? 'QR 码' : '收起 QR';
        });
      }
    });
  }

  async function copyText(text: string, btn: HTMLButtonElement | null, status: HTMLElement | null) {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      // fallback: 创建临时 textarea
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }
    if (status) {
      status.classList.remove('hidden');
      setTimeout(() => status.classList.add('hidden'), 2000);
    }
    if (btn) {
      const original = btn.textContent;
      btn.textContent = '✓ 已复制';
      setTimeout(() => { btn.textContent = original; }, 2000);
    }
  }

  initShareBars();
</script>