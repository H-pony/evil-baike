---
/**
 * ShareBar - 分享按钮
 *
 * 优先使用 navigator.share（移动端原生），fallback 复制链接
 * 提供：原生分享 / 复制链接 / 邮件 / X 分享。
 */

interface Props {
  url: string;       // 完整 URL（og:url）
  title: string;     // 标题
  summary: string;   // 摘要
}

const { url, title, summary } = Astro.props;

// 邮件链接预填
const mailSubject = encodeURIComponent(`[恶人百科] ${title}`);
const mailBody = encodeURIComponent(`${summary}\n\n${url}`);

// Twitter / X 分享
const twitterText = encodeURIComponent(`${title} — 恶人百科`);

---

<div class="archive-box share-panel no-print" data-share-bar data-url={url} data-title={title}>
  <div class="meta-stamp mb-3">分享</div>
  <div class="flex flex-wrap items-center gap-2">
    <button
      type="button"
      data-share-native
      class="pill-button share-primary"
    >
      分享
    </button>

    <button
      type="button"
      data-share-copy
      data-url={url}
      class="pill-button"
    >
      复制链接
    </button>

    <a
      href={`mailto:?subject=${mailSubject}&body=${mailBody}`}
      class="pill-button"
    >
      邮件
    </a>

    <a
      href={`https://twitter.com/intent/tweet?text=${twitterText}&url=${encodeURIComponent(url)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="pill-button"
    >
      X / Twitter
    </a>

  </div>
  <p data-share-status class="text-xs text-ink-muted mt-2" role="status" aria-live="polite"></p>
  <div data-share-manual hidden class="mt-3">
    <label class="text-xs text-ink-muted">手动复制链接<input type="text" readonly value={url} class="manual-copy-field" /></label>
  </div>
</div>

<style>
  .share-panel { min-width: 0; flex: 1; padding: 18px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); }
  .share-panel > .meta-stamp { color: var(--muted); font-size: 10px; letter-spacing: .12em; }
  .share-panel .pill-button { min-height: 44px; padding: 9px 15px; border-color: var(--line); background: var(--surface-raised); color: var(--text); font-size: 11px; }
  .share-panel .pill-button:hover { border-color: var(--accent); }
  .share-panel .share-primary { color: var(--page); background: var(--accent); border-color: var(--accent); }
  .share-panel .share-primary:hover { color: var(--page); background: var(--text); border-color: var(--text); }
  [data-share-status] { color: var(--muted); font-size: 12px; line-height: 1.7; }
  [data-share-status]:empty { display: none; }
  .manual-copy-field { width: 100%; margin-top: 8px; padding: 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--page); color: var(--text); font-size: 12px; }
</style>

<script>
  function initShareBars() {
    document.querySelectorAll<HTMLElement>('[data-share-bar]').forEach((bar) => {
      const url = bar.dataset.url ?? '';
      const title = bar.dataset.title ?? '';

      const native = bar.querySelector<HTMLButtonElement>('[data-share-native]');
      const copy = bar.querySelector<HTMLButtonElement>('[data-share-copy]');
      const status = bar.querySelector<HTMLElement>('[data-share-status]');
      const manual = bar.querySelector<HTMLElement>('[data-share-manual]');
      const announce = (message: string) => { if (status) status.textContent = message; };
      const copyLink = async () => {
        let copied = false;
        try { await navigator.clipboard.writeText(url); copied = true; } catch {
          const ta = document.createElement('textarea');
          ta.value = url;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { copied = document.execCommand('copy'); } catch {}
          ta.remove();
          copy?.focus();
        }
        if (copied) { if (manual) manual.hidden = true; announce('链接已复制。'); }
        else {
          announce('未能自动复制，请在下方选择并复制链接。');
          if (manual) { manual.hidden = false; const field = manual.querySelector<HTMLInputElement>('input'); field?.focus(); field?.select(); }
        }
      };

      if (native) {
        native.addEventListener('click', async () => {
          if (navigator.share) {
            try {
              await navigator.share({ title, url });
            } catch (err) {
              // 用户取消不报错
              if ((err as Error).name !== 'AbortError') announce('系统分享暂时不可用，请使用「复制链接」或邮件分享。');
            }
          } else {
            // fallback：复制
            await copyLink();
          }
        });
      }

      if (copy) {
        copy.addEventListener('click', async () => {
          await copyLink();
        });
      }

    });
  }

  initShareBars();
</script>
