---
/** Person card with a neutral initial tile; colors do not imply a judgment. */

import StatusBadge from './StatusBadge.astro';

interface Props {
  id: string;
  name: string;
  summary: string;
  status: 'draft' | 'submitted' | 'reviewing' | 'published' | 'archived' | 'withdrawn';
  aliases?: string[];
  eventCount: number;
}

const { id, name, summary, status, aliases = [], eventCount } = Astro.props;

/** 取首字符（中文取首字 / 英文取首字母组合）。括号内注解不计入。 */
function getInitials(name: string): string {
  const trimmed = name.trim();
  if (!trimmed) return '?';
  const withoutParens = trimmed.replace(/[（(][^）)]*[）)]/g, '').trim();
  const cn = withoutParens.match(/[\u4e00-\u9fa5]/);
  if (cn) return cn[0];
  const parts = withoutParens.split(/\s+/).filter(Boolean);
  if (parts.length === 0) return trimmed.slice(0, 1).toUpperCase();
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + (parts[1]?.[0] ?? '')).toUpperCase();
}

/** Stable neutral tile tones keep the same person recognizable across pages. */
function getAvatarTone(id: string): number {
  let hash = 0;
  for (let i = 0; i < id.length; i++) hash = ((hash << 5) - hash + id.charCodeAt(i)) | 0;
  return Math.abs(hash) % 3;
}

const initials = getInitials(name);
const avatarTone = getAvatarTone(id);
---

<a href={`/people/${id}`} class="entity-card card-link block archive-box hover:border-archive-seal transition-colors">
  <div class="flex items-start gap-3 mb-2">
    <!-- 匿名化头像：首字方块 -->
    <div
      class="person-avatar"
      data-avatar-tone={avatarTone}
      aria-hidden="true"
      data-person-avatar={id}
    >
      {initials}
    </div>

    <div class="flex-1 min-w-0">
      <div class="flex items-start justify-between gap-2 mb-2">
        <span class="entity-kind">人物</span>
        <StatusBadge status={status} size="sm" />
      </div>
      <h3 class="card-title font-display font-semibold text-xl leading-tight">
        {name}
      </h3>
    </div>
  </div>

  {aliases.length > 0 && (
    <p class="entity-aliases">又称：{aliases.join(' · ')}</p>
  )}

  <p class="entity-summary">{summary}</p>

  <div class="entity-count">
    涉及事件 {eventCount}
  </div>
</a>

<style>
  .entity-card { display: flex; flex-direction: column; height: 100%; min-width: 0; padding: 26px; border: 1px solid var(--line); border-radius: 9px; background: var(--surface); color: var(--text); text-decoration: none; transition: border-color .2s ease; }
  .entity-card:hover { border-color: var(--accent); }
  .person-avatar { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 56px; height: 66px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface-raised); color: var(--text); font-size: 30px; font-weight: 700; line-height: 1; }
  .person-avatar[data-avatar-tone="1"] { background: color-mix(in srgb, var(--text) 5%, var(--surface-raised)); }
  .person-avatar[data-avatar-tone="2"] { background: color-mix(in srgb, var(--text) 10%, var(--surface-raised)); }
  .entity-kind { color: var(--muted); font-size: 10px; letter-spacing: .08em; }
  .card-title { color: var(--text); margin-top: 8px; font-size: 27px; line-height: 1.3; letter-spacing: -.05em; font-weight: 700; }
  .entity-aliases { margin: 10px 0 14px; color: var(--muted); font-size: 11px; line-height: 1.8; }
  .entity-summary { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; margin: 12px 0 24px; color: var(--muted); font-size: 13px; line-height: 1.9; }
  .entity-count { margin-top: auto; padding-top: 15px; border-top: 1px solid var(--line); color: var(--text); font-size: 11px; text-align: right; }
  @media (max-width: 600px) { .entity-card { padding: 22px; } }
</style>
