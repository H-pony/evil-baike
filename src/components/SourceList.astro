---
/**
 * SourceList - 信源列表（事实溯源用）
 *
 * 每条信源显示：
 *   - 标题（链接到原始 URL）
 *   - 发布者
 *   - 发布日期
 *   - 访问日期（必备，学术引用要求）
 *   - 存档链接（如有）
 *   - 备注
 */

interface Source {
  url: string;
  title: string;
  publisher?: string;
  publishedAt?: Date;
  accessedAt?: Date;
  archive?: string;
  note?: string;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;

function formatDate(d?: Date): string {
  return d ? d.toISOString().slice(0, 10) : '';
}

const totalCount = sources.length;
const missingAccess = sources.filter((s) => !s.accessedAt).length;
---

<div data-source-list>
  {missingAccess > 0 && (
    <p class="meta-stamp mb-3 text-archive-seal/80">
      ⚠ {missingAccess} / {totalCount} 条信源缺少访问日期（建议补全以便学术引用）
    </p>
  )}

  <ol class="space-y-3 font-serif">
    {sources.map((src, idx) => (
      <li class="flex gap-3 pb-3 border-b border-ink-900/10 last:border-b-0">
        <span class="source-number">
          [{String(idx + 1).padStart(2, '0')}]
        </span>
        <div class="flex-1 min-w-0">
          <a
            href={src.url}
            rel="noopener noreferrer nofollow"
            target="_blank"
            class="font-medium break-words"
          >
            {src.title}
          </a>
          <div class="text-xs text-ink-muted mt-1 font-mono flex flex-wrap gap-x-3 gap-y-0.5">
            {src.publisher && <span>发布：{src.publisher}</span>}
            {src.publishedAt && <span>· {formatDate(src.publishedAt)}</span>}
            {src.accessedAt ? (
              <span>· 访问 {formatDate(src.accessedAt)}</span>
            ) : (
              <span class="text-archive-seal/80">· 访问日期未填</span>
            )}
            {src.archive && (
              <a href={src.archive} rel="noopener noreferrer nofollow" target="_blank" class="text-archive-seal">
                · 存档
              </a>
            )}
          </div>
          {src.note && (
            <p class="text-xs text-ink-muted mt-1 italic">{src.note}</p>
          )}
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
  [data-source-list] { color: var(--text); }
  [data-source-list] > ol { list-style: none; padding: 0; }
  [data-source-list] > ol > li { gap: 18px; padding: 22px 0; margin: 0; border-color: var(--line); }
  .source-number { flex-shrink: 0; padding-top: 3px; color: var(--accent); font-size: 11px; letter-spacing: .03em; }
  [data-source-list] a { color: var(--text); text-decoration-color: var(--line); text-underline-offset: 4px; }
  [data-source-list] a:hover { color: var(--accent); }
  [data-source-list] li > div > a { font-size: 15px; font-weight: 500; line-height: 1.8; }
  [data-source-list] li > div > div { margin-top: 8px; color: var(--muted); font-size: 11px; line-height: 1.7; }
  [data-source-list] p { color: var(--muted); line-height: 1.8; }
</style>
