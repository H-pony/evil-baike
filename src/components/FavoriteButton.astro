---
/**
 * FavoriteButton - 收藏按钮（localStorage）
 *
 * 用法：
 *   <FavoriteButton type="event" id="2023-wu-library-allegation" title="..." />
 *
 * localStorage key: 'evil-baike-favs' = JSON.stringify({event: ['id1'], person: [], organization: []})
 */

interface Props {
  type: 'event' | 'person' | 'organization';
  id: string;
  title: string;
}

const { type, id, title } = Astro.props;
---

<button
  type="button"
  data-fav-btn
  data-fav-type={type}
  data-fav-id={id}
  data-fav-title={title}
  class="favorite-button"
  aria-label="加入收藏"
  aria-pressed="false"
  title="加入收藏 / 取消收藏（仅本地存储）"
>
  <span data-fav-star aria-hidden="true">☆</span>
  <span data-fav-label>收藏</span>
</button>

<span data-fav-feedback role="status" class="text-sm text-ink-muted"></span>
<script>
  import { FAVORITES_KEY, FAVORITES_CHANGED, readFavorites, saveFavorites, type FavoriteType } from '~/lib/favorites';

  function renderBtn(btn: HTMLButtonElement) {
    const type = btn.dataset.favType as FavoriteType;
    const active = readFavorites()[type].some(favorite => favorite.id === btn.dataset.favId);
    btn.querySelector('[data-fav-star]')!.textContent = active ? '★' : '☆';
    btn.querySelector('[data-fav-label]')!.textContent = active ? '已收藏' : '收藏';
    btn.setAttribute('aria-pressed', String(active));
    btn.setAttribute('aria-label', active ? '取消收藏' : '加入收藏');
  }
  function sync() { document.querySelectorAll<HTMLButtonElement>('[data-fav-btn]').forEach(renderBtn); }
  document.querySelectorAll<HTMLButtonElement>('[data-fav-btn]').forEach(btn => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.favType as FavoriteType;
      const id = btn.dataset.favId!;
      const favorites = readFavorites();
      const index = favorites[type].findIndex(favorite => favorite.id === id);
      if (index >= 0) favorites[type].splice(index, 1);
      else favorites[type].push({ id, title: btn.dataset.favTitle ?? '', ts: Date.now() });
      const saved = saveFavorites(favorites);
      const feedback = btn.nextElementSibling;
      if (feedback?.hasAttribute('data-fav-feedback')) feedback.textContent = saved ? (index >= 0 ? '已取消收藏' : '已保存到本机收藏') : '收藏未保存，请允许浏览器存储后重试。';
      renderBtn(btn);
    });
  });
  window.addEventListener(FAVORITES_CHANGED, sync);
  window.addEventListener('storage', event => { if (event.key === FAVORITES_KEY || event.key === null) sync(); });
  sync();
</script>

<style>
  .favorite-button { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 44px; padding: 10px 18px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--text); font-size: 12px; font-weight: 600; line-height: 1.4; transition: border-color .2s ease, background .2s ease; }
  .favorite-button:hover { border-color: var(--accent); }
  .favorite-button[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--page); }
  [data-fav-star] { font-size: 18px; line-height: 1; }
  [data-fav-feedback] { align-self: center; max-width: 26em; color: var(--muted); font-size: 12px; line-height: 1.7; }
  [data-fav-feedback]:empty { display: none; }
</style>
