---
/**
 * 人物详情页
 *
 * 发布边界：只对 status === 'published' 或 'archived' 的条目生成 HTML。
 */
import EntryLayout from '~/layouts/EntryLayout.astro';
import EntityLink from '~/components/EntityLink.astro';
import { getCollection, render } from 'astro:content';
import { isPubliclyVisible, isIndexable } from '~/content.config';
import { eventHasPerson, personHasOrganization, getEventOrganizations } from '~/lib/relations';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const people = await getCollection('people', (p) => isPubliclyVisible(p.data.status));
  return people.map((person) => ({
    params: { slug: person.id },
    props: { person },
  }));
}) satisfies GetStaticPaths;

const { person } = Astro.props;
const { Content } = await render(person);

// 找出涉及此人的事件（仅列出已发布）
const allEvents = await getCollection('events', (e) => isIndexable(e.data.status));
const relatedEvents = allEvents
  .filter((e) => eventHasPerson(e, person))
  .sort((a, b) => b.data.dateStart.getTime() - a.data.dateStart.getTime());

const orgs = await getCollection('organizations', (o) => isPubliclyVisible(o.data.status));
const relatedOrgs = orgs.filter(org => personHasOrganization(person, org));

const typeLabels: Record<string, string> = {
  criminal: '刑事',
  legal: '法律',
  corporate: '企业',
  controversy: '争议',
  'public-safety': '公共安全',
  moral: '道德',
  'human-rights': '人权',
  media: '媒体',
};
---

<EntryLayout
  entryType="person"
  entryId={person.id}
  title={person.data.name}
  summary={person.data.summary}
  status={person.data.status}
  type="人物"
  aliases={person.data.aliases}
  tags={person.data.tags}
  sources={person.data.sources}
  breadcrumbs={[
    { label: '首页', href: '/' },
    { label: '人物', href: '/people' },
    { label: person.data.name },
  ]}
  meta={{
    authors: person.data.authors,
    reviewers: person.data.reviewers,
    createdAt: person.data.createdAt,
    updatedAt: person.data.updatedAt,
    verifiedAt: person.data.verifiedAt,
    contested: person.data.contested,
    archivedReason: person.data.archivedReason,
    archivedNote: person.data.archivedNote,
  }}
>
  <Content />

  {relatedOrgs.length > 0 && (
    <section class="mt-10 pt-6 border-t border-ink-900/30">
      <h2 class="headline text-xl mb-4">关联机构</h2>
      <div class="flex flex-wrap gap-2">
        {relatedOrgs.map(org => (
          <EntityLink type="organization" id={org.id}>{org.data.name}</EntityLink>
        ))}
      </div>
    </section>
  )}

  {relatedEvents.length > 0 && (
    <section class="mt-12 pt-6 border-t border-ink-900/30">
      <div class="flex items-baseline justify-between mb-4">
        <h2 class="headline text-2xl">涉及事件</h2>
        <span class="meta-stamp">[{relatedEvents.length} 条 · 按事件发生时间倒序]</span>
      </div>
      <ul class="space-y-3">
        {relatedEvents.map((e) => (
          <li class="archive-box">
            <a
              href={`/events/${e.id}`}
              class="block hover:text-archive-seal transition-colors no-underline"
            >
              <div class="flex items-center gap-2 mb-2 flex-wrap">
                <span class="meta-stamp border border-ink-900/30 px-2 py-0.5">
                  {typeLabels[e.data.type] ?? e.data.type}
                </span>
                <span class="meta-stamp text-ink-faded">
                  {e.data.dateStart.toISOString().slice(0, 10)}
                  {e.data.dateEnd ? ` – ${e.data.dateEnd.toISOString().slice(0, 10)}` : ' –'}
                </span>
              </div>
              <h3 class="card-title font-display font-semibold text-lg mb-1">
                {e.data.title}
              </h3>
              <p class="text-sm text-ink-muted line-clamp-2">{e.data.summary}</p>
              </a>
              {getEventOrganizations(e, orgs).length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-2">
                  <span class="meta-stamp text-ink-faded text-xs">涉及机构：</span>
                  {getEventOrganizations(e, orgs).map(org => (
                    <EntityLink type="organization" id={org.id}>{org.data.name}</EntityLink>
                  ))}
                </div>
              )}
          </li>
        ))}
      </ul>
    </section>
  )}
</EntryLayout>
