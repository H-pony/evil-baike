---
/**
 * 收藏夹页（本地存储）
 *
 * - 服务端渲染所有 published+archived 条目作为 DOM 节点（隐藏）
 * - 客户端 JS 读取 localStorage 并取消隐藏匹配的条目
 * - 空收藏时显示空态
 *
 * 优点：无 SSR hydration cost、SEO 友好、JS 失败时页面仍可浏览（只是看不到收藏）
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import EventCard from '~/components/EventCard.astro';
import PersonCard from '~/components/PersonCard.astro';
import OrgCard from '~/components/OrgCard.astro';
import { getCollection } from 'astro:content';
import { isPubliclyVisible, isIndexable } from '~/content.config';
import { eventHasPerson, eventHasOrganization } from '~/lib/relations';

const events = await getCollection('events', (e) => isPubliclyVisible(e.data.status));
const people = await getCollection('people', (p) => isPubliclyVisible(p.data.status));
const orgs = await getCollection('organizations', (o) => isPubliclyVisible(o.data.status));

const typeLabels: Record<string, string> = {
  criminal: '刑事案件', legal: '法律诉讼', corporate: '企业丑闻',
  controversy: '公共争议', 'public-safety': '公共安全', moral: '道德争议',
  'human-rights': '人权事件', media: '媒体争议',
};

const orgTypeLabels: Record<string, string> = {
  company: '企业', government: '政府', 'political-party': '政党',
  ngo: 'NGO', academic: '学术机构', media: '媒体',
  religious: '宗教', military: '军事', other: '其他',
};

// Counts use the same indexed-event relationship union as entity detail pages.
const indexedEvents = events.filter(event => isIndexable(event.data.status));
const personEventCounts = new Map(people.map(person => [person.id, indexedEvents.filter(event => eventHasPerson(event, person)).length]));
const orgEventCounts = new Map(orgs.map(org => [org.id, indexedEvents.filter(event => eventHasOrganization(event, org)).length]));

// 按时间倒序（收藏夹里最新收藏在前，先按时间排序作为 tiebreaker）
events.sort((a, b) => b.data.dateStart.getTime() - a.data.dateStart.getTime());
---

<BaseLayout title="我的收藏" description="你加入收藏的事件 / 人物 / 机构（仅存储在本地浏览器）">
  <header class="text-center py-8 border-b-3 border-double border-ink-900 mb-8">
    <p class="meta-stamp mb-2">我的阅读清单</p>
    <h1 class="headline text-4xl lg:text-5xl">我的收藏</h1>
    <p class="deck mt-2">
      收藏仅保存在当前浏览器 · 清空浏览器数据会丢失
    </p>
  </header>

  <noscript><p class="archive-box p-4 mb-4">启用 JavaScript 后可查看本机收藏。</p></noscript>
  <p data-fav-feedback role="status" class="text-sm text-ink-muted mb-4"></p>
  <div data-fav-unavailable hidden class="archive-box p-4 mb-4">
    <p>有 <strong data-fav-unavailable-count>0</strong> 条收藏已下线或暂不可访问，未显示在下方。</p>
    <button type="button" data-fav-remove-unavailable class="pill-button mt-3">移除不可访问的收藏</button>
  </div>
  <!-- 空态：未收藏任何条目 -->
  <div data-fav-empty class="archive-box p-8 text-center">
    <p class="text-2xl font-display mb-2">暂无可显示的收藏</p>
    <p class="text-sm text-ink-muted mb-4">
      在任何事件 / 人物 / 机构详情页点击右上角的「☆ 收藏」按钮即可加入此处。
    </p>
    <div class="flex justify-center gap-3 text-sm">
      <a href="/events" class="badge border-ink-900 hover:bg-ink-900 hover:text-archive-paper no-underline">浏览事件</a>
      <a href="/people" class="badge border-ink-900 hover:bg-ink-900 hover:text-archive-paper no-underline">浏览人物</a>
      <a href="/organizations" class="badge border-ink-900 hover:bg-ink-900 hover:text-archive-paper no-underline">浏览机构</a>
    </div>
  </div>

  <!-- 收藏统计 -->
  <div data-fav-stats hidden class="archive-box p-4 mb-6 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap gap-4 text-sm font-mono">
      <span>收藏总数 <strong data-fav-total class="text-archive-seal">0</strong></span>
      <span class="text-ink-muted">
        事件 <strong data-fav-event-count>0</strong> ·
        人物 <strong data-fav-person-count>0</strong> ·
        机构 <strong data-fav-org-count>0</strong>
      </span>
    </div>
    <button
      type="button"
      data-fav-clear
      class="text-xs font-mono uppercase tracking-wider px-3 py-1.5 border border-archive-seal/40 text-archive-seal hover:bg-archive-seal/10 transition-colors"
    >
      清空所有收藏
    </button>
  </div>

  <!-- 事件 -->
  <section data-fav-section="event" hidden class="mb-10">
    <h2 class="headline text-2xl mb-4 pb-2 border-b border-ink-900">
      收藏的事件 <span class="font-mono text-base text-ink-faded ml-2" data-fav-section-count>[0]</span>
    </h2>
    <div class="event-card-grid">
      {events.map((event) => (
        <div
          data-fav-card="event"
          data-fav-id={event.id}
          hidden
        >
          <EventCard
            id={event.id}
            title={event.data.title}
            summary={event.data.summary}
            type={typeLabels[event.data.type] ?? event.data.type}
            dateStart={event.data.dateStart}
            dateEnd={event.data.dateEnd}
            status={event.data.status}
            tags={event.data.tags}
            sourceCount={event.data.sources.length}
            timelineCount={event.data.timeline.length}
          />
          <button type="button" data-fav-remove="event" data-fav-id={event.id} class="pill-button mt-3" aria-label={`取消收藏：${event.data.title}`}>取消收藏</button>
        </div>
      ))}
    </div>
  </section>

  <!-- 人物 -->
  <section data-fav-section="person" hidden class="mb-10">
    <h2 class="headline text-2xl mb-4 pb-2 border-b border-ink-900">
      收藏的人物 <span class="font-mono text-base text-ink-faded ml-2" data-fav-section-count>[0]</span>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {people.map((person) => (
        <div
          data-fav-card="person"
          data-fav-id={person.id}
          hidden
        >
          <PersonCard
            id={person.id}
            name={person.data.name}
            summary={person.data.summary}
            status={person.data.status}
            aliases={person.data.aliases}
            eventCount={personEventCounts.get(person.id) ?? 0}
          />
          <button type="button" data-fav-remove="person" data-fav-id={person.id} class="pill-button mt-3" aria-label={`取消收藏：${person.data.name}`}>取消收藏</button>
        </div>
      ))}
    </div>
  </section>

  <!-- 机构 -->
  <section data-fav-section="organization" hidden class="mb-10">
    <h2 class="headline text-2xl mb-4 pb-2 border-b border-ink-900">
      收藏的机构 <span class="font-mono text-base text-ink-faded ml-2" data-fav-section-count>[0]</span>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {orgs.map((org) => (
        <div
          data-fav-card="organization"
          data-fav-id={org.id}
          hidden
        >
          <OrgCard
            id={org.id}
            name={org.data.name}
            summary={org.data.summary}
            type={orgTypeLabels[org.data.type] ?? org.data.type}
            status={org.data.status}
            aliases={org.data.aliases}
            eventCount={orgEventCounts.get(org.id) ?? 0}
          />
          <button type="button" data-fav-remove="organization" data-fav-id={org.id} class="pill-button mt-3" aria-label={`取消收藏：${org.data.name}`}>取消收藏</button>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  import { FAVORITES_KEY, FAVORITES_CHANGED, favoriteTypes, readFavorites, saveFavorites, type FavoriteType, type Favorites } from '~/lib/favorites';
  const available = Object.fromEntries(favoriteTypes.map(type => [type, new Set(Array.from(document.querySelectorAll<HTMLElement>(`[data-fav-card="${type}"]`)).map(card => card.dataset.favId!))])) as Record<FavoriteType, Set<string>>;

  function render() {
    const favorites = readFavorites();
    const visibleFavorites = Object.fromEntries(favoriteTypes.map(type => [type, favorites[type].filter(item => available[type].has(item.id))])) as Favorites;
    const counts = favoriteTypes.map(type => visibleFavorites[type].length);
    const total = counts.reduce((sum, count) => sum + count, 0);
    const unavailable = favoriteTypes.reduce((sum, type) => sum + favorites[type].length - visibleFavorites[type].length, 0);
    document.querySelector<HTMLElement>('[data-fav-empty]')!.hidden = total > 0;
    document.querySelector<HTMLElement>('[data-fav-stats]')!.hidden = total === 0;
    document.querySelector<HTMLElement>('[data-fav-unavailable]')!.hidden = unavailable === 0;
    document.querySelector('[data-fav-unavailable-count]')!.textContent = String(unavailable);
    document.querySelector('[data-fav-total]')!.textContent = String(total);
    ['event', 'person', 'org'].forEach((type, i) => { document.querySelector(`[data-fav-${type}-count]`)!.textContent = String(counts[i]); });
    for (const type of favoriteTypes) {
      const timestamps = new Map(visibleFavorites[type].map(item => [item.id, item.ts]));
      const section = document.querySelector<HTMLElement>(`[data-fav-section="${type}"]`)!;
      section.hidden = timestamps.size === 0;
      section.querySelector('[data-fav-section-count]')!.textContent = `[${timestamps.size}]`;
      const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-fav-card]'));
      cards.sort((a, b) => (timestamps.get(b.dataset.favId!) ?? 0) - (timestamps.get(a.dataset.favId!) ?? 0));
      for (const card of cards) { card.hidden = !timestamps.has(card.dataset.favId!); card.parentElement!.append(card); }
    }
  }
  function save(favorites: Favorites, success: string) {
    const saved = saveFavorites(favorites);
    document.querySelector('[data-fav-feedback]')!.textContent = saved ? success : '修改未保存，请允许浏览器存储后重试。';
    if (saved) render();
  }
  document.querySelector('[data-fav-clear]')?.addEventListener('click', () => {
    if (confirm('确定清空所有收藏？此操作不可撤销。')) save({ event: [], person: [], organization: [] }, '已清空所有收藏');
  });
  document.querySelector('[data-fav-remove-unavailable]')?.addEventListener('click', () => {
    const favorites = readFavorites();
    for (const type of favoriteTypes) favorites[type] = favorites[type].filter(item => available[type].has(item.id));
    save(favorites, '已移除不可访问的收藏');
  });
  document.querySelectorAll<HTMLButtonElement>('[data-fav-remove]').forEach(button => {
    button.addEventListener('click', () => {
      const type = button.dataset.favRemove as FavoriteType;
      const favorites = readFavorites();
      favorites[type] = favorites[type].filter(item => item.id !== button.dataset.favId);
      save(favorites, '已取消收藏');
    });
  });
  window.addEventListener(FAVORITES_CHANGED, render);
  window.addEventListener('storage', event => { if (event.key === FAVORITES_KEY || event.key === null) render(); });
  render();
</script>
