---
import BaseLayout from '~/layouts/BaseLayout.astro';
import '~/styles/flip-stage.css';
import EventCard from '~/components/EventCard.astro';
import PersonCard from '~/components/PersonCard.astro';
import OrgCard from '~/components/OrgCard.astro';
import { getCollection } from 'astro:content';
import { isIndexable } from '~/content.config';
import { eventHasPerson, eventHasOrganization } from '~/lib/relations';
const events = (await getCollection('events', e => isIndexable(e.data.status))).sort((a,b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime() || b.data.dateStart.getTime() - a.data.dateStart.getTime());
const people = await getCollection('people', e => isIndexable(e.data.status));
const organizations = await getCollection('organizations', e => isIndexable(e.data.status));
const tags = [...new Set(events.flatMap(e => e.data.tags))].slice(0,10);
const sourceCount = events.reduce((count,event) => count + event.data.sources.length,0);
const orbit = Array.from('SCROLL DOWN · SCROLL DOWN · ');
---
<BaseLayout title="恶人百科" description="公共事件的永久档案馆 · 沿时间线阅读，循着信源理解事实" fullBleed>
  <div class="flip-story" data-flip-story><div class="flip-stage">
  <section class="archive-portal" aria-labelledby="portal-title" data-portal>
    <div class="portal-tiles" aria-hidden="true">{Array.from({length:36},(_,index)=><div class="portal-tile" style={`--tile-index:${index}`}></div>)}</div>
    <div class="portal-seams" aria-hidden="true">{Array.from({length:36},()=> <span></span>)}</div>
    <a class="scroll-orbit" href="#archive" aria-label="向下浏览档案">
      <span class="orbit-letters" aria-hidden="true">{orbit.map((letter,index)=><span style={`--letter-angle:${index * 360 / orbit.length}deg`}>{letter}</span>)}</span>
      <span class="orbit-core" aria-hidden="true"><img src="/icons/arrow.svg" alt="" /></span>
    </a>
    <div class="portal-brand"><h1 id="portal-title">恶人百科</h1><p class="portal-signature">让事实，留下来。</p></div>
    <div class="portal-bottom"><span>PUBLIC EVENTS.<br />PERMANENT RECORDS.</span><a href="#archive">探索档案 <img src="/icons/arrow.svg" alt="" /></a><span>独立记录 / 持续核查</span></div>
    <span class="portal-copyright" aria-hidden="true">© {new Date().getFullYear()} EVIL BAIKE · THE PUBLIC ARCHIVE</span>
  </section>

  <section class="archive-manifesto" id="archive" aria-labelledby="manifesto-title">
    <p class="manifesto-outline" aria-hidden="true">FACTS × CONTEXT</p>
    <div class="manifesto-content"><p class="eyebrow">01 / WHY WE RECORD</p><h2 id="manifesto-title">网络会遗忘。<br />记录，让事实留下来。</h2><p>从一条报道，到完整的来龙去脉。<br />沿着时间线回看经过，循着原始信源理解事实。</p><a href="/events" class="manifesto-link">开始阅读档案 <img src="/icons/arrow.svg" alt="" /></a></div>
    <div class="manifesto-stats"><span><strong>{events.length.toString().padStart(2,'0')}</strong>事件档案</span><span><strong>{people.length.toString().padStart(2,'0')}</strong>相关人物</span><span><strong>{organizations.length.toString().padStart(2,'0')}</strong>相关机构</span><span><strong>{sourceCount}</strong>可溯信源</span></div>
  </section>

  </div></div>

  <section class="archive-section archive-records" aria-labelledby="records-heading">
    <div class="section-masthead"><h2 id="records-heading">RECORDS<span>事件档案</span></h2><p>02 / RECENTLY UPDATED</p></div>
    <div class="records-grid">{events.slice(0,4).map(event=><EventCard id={event.id} title={event.data.title} summary={event.data.summary} type={event.data.type} dateStart={event.data.dateStart} dateEnd={event.data.dateEnd} status={event.data.status} tags={event.data.tags} sourceCount={event.data.sources.length} timelineCount={event.data.timeline.length}/>)}</div>
    {events.length === 0 && <p class="archive-box">档案正在整理中。<a href="/submit">提交事件或信源</a></p>}
    <a href="/events?sort=updated" class="section-text-link">全部事件档案 <img src="/icons/arrow.svg" alt="" /></a>
  </section>

  <section class="archive-section" aria-labelledby="index-heading"><div class="section-masthead"><h2 id="index-heading">INDEX<span>人物与机构</span></h2><p>03 / CONNECT THE DOTS</p></div>
    <div class="index-intro"><p>事件之间，<br />有迹可循。</p><div>从一个名字出发，连接人物、机构与公开记录。收录仅为呈现事件关系，不代表对任何人的定性。</div></div>
    <div class="index-switch"><h3>相关人物 <span>PEOPLE</span></h3><a href="/people">查看全部 <img src="/icons/arrow.svg" alt="" /></a></div>
    <div class="entity-grid">{people.slice(0,3).map(person=><PersonCard id={person.id} name={person.data.name} summary={person.data.summary} status={person.data.status} aliases={person.data.aliases} eventCount={events.filter(event=>eventHasPerson(event,person)).length}/>)}</div>
    <div class="index-switch"><h3>机构记录 <span>ORGANIZATIONS</span></h3><a href="/organizations">查看全部 <img src="/icons/arrow.svg" alt="" /></a></div>
    <div class="entity-grid org-grid">{organizations.slice(0,4).map(org=><OrgCard id={org.id} name={org.data.name} summary={org.data.summary} type={org.data.type === 'academic' ? '教育机构' : org.data.type === 'government' ? '公共机构' : org.data.type} status={org.data.status} aliases={org.data.aliases} eventCount={events.filter(event=>eventHasOrganization(event,org)).length}/>)}</div>
  </section>

  <section class="archive-section archive-topics" aria-labelledby="topics-heading"><div class="section-masthead"><h2 id="topics-heading">TOPICS<span>话题索引</span></h2><p>04 / FOLLOW THE THREAD</p></div><div class="topic-directory">{tags.map((tag,index)=><a href={`/tags/${encodeURIComponent(tag)}`}><span>{String(index+1).padStart(2,'0')}</span><strong>{tag}</strong><img src="/icons/arrow.svg" alt="" /></a>)}</div><a href="/tags" class="section-text-link">全部话题 <img src="/icons/arrow.svg" alt="" /></a></section>

  <section class="archive-values" aria-label="收录原则"><a href="/methodology"><span>01 / SOURCES</span><h2>严格信源</h2><p>事实附可溯源链接。<br />无信源，不入档。</p><img src="/icons/arrow.svg" alt="" /></a><a href="/disclaimer"><span>02 / CONTEXT</span><h2>中立记录</h2><p>保留各方公开陈述。<br />区分指控与调查结论。</p><img src="/icons/arrow.svg" alt="" /></a><a href="/submit"><span>03 / CORRECTIONS</span><h2>开放更正</h2><p>欢迎补充证据、报告错误。<br />让记录持续接近事实。</p><img src="/icons/arrow.svg" alt="" /></a></section>
</BaseLayout>
<script>
  import { initFlipStage } from '~/lib/flip-stage';
  initFlipStage();
</script>
