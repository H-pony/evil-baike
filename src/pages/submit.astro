---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="投稿" description="向恶人百科提交事件投稿">
  <div class="submission-page">
    <header class="submission-header">
      <p class="meta-stamp mb-2">投稿入口</p>
      <h1 class="headline text-4xl lg:text-5xl">提交事件</h1>
      <p class="deck mt-3 max-w-2xl mx-auto">留下姓名和事件内容，投稿会进入后台等待人工查看。</p>
    </header>

    <section class="submission-card archive-box" aria-labelledby="submission-title">
      <h2 id="submission-title" class="headline text-2xl mb-6">投稿信息</h2>
      <form id="submission-form" class="submission-form">
        <div class="field-group">
          <label for="submitter-name">姓名</label>
          <input id="submitter-name" name="name" type="text" autocomplete="name" maxlength="80" required />
        </div>
        <div class="field-group">
          <label for="event-description">事件</label>
          <textarea id="event-description" name="event" rows="9" maxlength="5000" required></textarea>
          <p class="field-help">最多 5000 个字符。请勿填写身份证号、住址等敏感信息。</p>
        </div>
        <button id="submit-button" class="submit-button" type="submit">提交投稿</button>
      </form>
      <p id="submission-message" class="submission-message" role="status" aria-live="polite"></p>
    </section>
  </div>
</BaseLayout>

<style>
  .submission-page { max-width: 760px; margin: 0 auto; }
  .submission-header { text-align: center; padding: 2rem 0; border-bottom: 3px double #211d19; margin-bottom: 2rem; }
  .submission-card { padding: clamp(1.2rem, 4vw, 2rem); }
  .submission-form { display: grid; gap: 1.35rem; }
  .field-group { display: grid; gap: .5rem; }
  .field-group label { color: #332d26; font: 600 .92rem/1.4 ui-sans-serif, system-ui, sans-serif; }
  .field-group input, .field-group textarea { width: 100%; border: 1px solid rgb(33 29 25 / 35%); border-radius: 2px; background: #fffefa; padding: .8rem .9rem; color: #211d19; font: 1rem/1.6 ui-sans-serif, system-ui, sans-serif; }
  .field-group textarea { resize: vertical; min-height: 190px; }
  .field-group input:focus, .field-group textarea:focus { outline: 2px solid #8a6846; outline-offset: 1px; }
  .field-help { margin: 0; color: #776f65; font: .78rem/1.5 ui-sans-serif, system-ui, sans-serif; }
  .submit-button { justify-self: start; min-height: 44px; border: 1px solid #211d19; background: #211d19; color: #fffefa; padding: .65rem 1.2rem; font: 600 .88rem ui-sans-serif, system-ui, sans-serif; cursor: pointer; }
  .submit-button:hover { background: #59442e; }
  .submit-button:disabled { opacity: .6; cursor: wait; }
  .submission-message { min-height: 1.4em; margin: .8rem 0 0; color: #75634c; font: .88rem/1.5 ui-sans-serif, system-ui, sans-serif; }
</style>

<script>
  const submissionForm = document.querySelector<HTMLFormElement>('#submission-form')!;
  const submissionMessage = document.querySelector<HTMLParagraphElement>('#submission-message')!;
  const submitButton = document.querySelector<HTMLButtonElement>('#submit-button')!;
  const eventField = document.querySelector<HTMLTextAreaElement>('#event-description')!;
  const prefilledEvent = new URLSearchParams(window.location.search).get('event');

  if (prefilledEvent) eventField.value = prefilledEvent.slice(0, 5000);

  submissionForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const values = new FormData(submissionForm);
    const name = String(values.get('name') || '').trim();
    const eventText = String(values.get('event') || '').trim();
    submitButton.disabled = true;
    submissionMessage.textContent = '正在提交…';

    try {
      const response = await fetch('/api/submissions', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, event: eventText }),
      });
      const result = await response.json();
      if (!response.ok) {
        submissionMessage.textContent = result.error || '暂时无法提交，请稍后重试。';
        return;
      }

      submissionForm.reset();
      submissionMessage.textContent = '投稿已收到，感谢提交。';
    } catch {
      submissionMessage.textContent = '连接失败，请检查网络后重试。';
    } finally {
      submitButton.disabled = false;
    }
  });
</script>
